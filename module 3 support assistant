import json
import os
from typing import TypedDict

import chromadb
from pydantic import BaseModel, Field, ValidationError
from sentence_transformers import SentenceTransformer
from langgraph.graph import StateGraph, START, END

from ingest import CHROMA_DIR, COLLECTION_NAME, MODEL_NAME
from prompts import STRUCTURED_PROMPT


class GraphState(TypedDict, total=False):
    query: str
    intent: str
    retrieved: list[dict]
    answer: str
    sources: list[str]
    confidence: float
    result: dict


class AskResponse(BaseModel):
    answer: str
    sources: list[str] = Field(default_factory=list)
    confidence: float = Field(ge=0.0, le=1.0)


POLICY_KEYWORDS = (
    "delivery", "return", "refund", "membership", "tracking",
    "cancel", "gift card", "support hours"
)


def mock_mode() -> bool:
    return os.getenv("MOCK_LLM", "1") != "0"


def get_collection():
    client = chromadb.PersistentClient(path=str(CHROMA_DIR))
    try:
        return client.get_collection(COLLECTION_NAME)
    except Exception:
        # Make first local startup convenient if ingestion has not been run.
        from ingest import build_index
        build_index()
        return client.get_collection(COLLECTION_NAME)


def classify_intent(state: GraphState) -> GraphState:
    query = state["query"]
    lowered = query.lower()

    if mock_mode():
        intent = (
            "policy_question"
            if any(keyword in lowered for keyword in POLICY_KEYWORDS)
            else "general_question"
        )
        return {"intent": intent}

    # Optional real-LLM extension. The required graded path never enters here.
    raw = call_real_llm(
        f"""Classify this query as exactly one of policy_question or general_question.
Query: {query}
Return JSON only: {{"intent":"policy_question"}}"""
    )
    try:
        value = json.loads(raw)["intent"]
        if value not in {"policy_question", "general_question"}:
            raise ValueError
        return {"intent": value}
    except Exception:
        # Safe fallback if the optional provider gives malformed output.
        return {"intent": "general_question"}


def retrieve_chunks(query: str, top_k: int = 3) -> list[dict]:
    model = SentenceTransformer(MODEL_NAME)
    embedding = model.encode([query], normalize_embeddings=True).tolist()
    collection = get_collection()

    result = collection.query(
        query_embeddings=embedding,
        n_results=top_k,
        include=["documents", "metadatas", "distances"],
    )

    rows = []
    for i, chunk_id in enumerate(result["ids"][0]):
        rows.append({
            "id": chunk_id,
            "text": result["documents"][0][i],
            "document_id": result["metadatas"][0][i]["document_id"],
            "distance": result["distances"][0][i],
        })
    return rows


def retrieve_and_answer(state: GraphState) -> GraphState:
    retrieved = retrieve_chunks(state["query"], top_k=3)
    source_ids = [item["id"] for item in retrieved]

    if mock_mode():
        snippet = retrieved[0]["text"][:200]
        answer = f"Based on the retrieved context: {snippet}"
        return {
            "retrieved": retrieved,
            "answer": answer,
            "sources": source_ids,
            "confidence": 1.0,
        }

    context = "\n\n".join(
        f"[{item['id']}] {item['text']}" for item in retrieved
    )
    prompt = STRUCTURED_PROMPT.format(
        context=context,
        question=state["query"],
    )

    raw = None
    last_error = None
    for attempt in range(3):
        try:
            if attempt == 0:
                raw = call_real_llm(prompt)
            else:
                raw = call_real_llm(
                    prompt
                    + "\n\nCORRECTION: Your previous output failed validation. "
                      "Return ONLY valid JSON matching the required schema. "
                      "confidence must be between 0 and 1."
                )
            parsed = json.loads(raw)
            validated = AskResponse.model_validate(parsed)
            return {
                "retrieved": retrieved,
                "answer": validated.answer,
                "sources": validated.sources,
                "confidence": validated.confidence,
            }
        except Exception as exc:
            last_error = exc

    return {
        "retrieved": retrieved,
        "answer": f"ERROR: real-LLM output failed schema validation after 3 attempts: {last_error}",
        "sources": [],
        "confidence": 0.0,
    }


def direct_answer(state: GraphState) -> GraphState:
    if mock_mode():
        return {
            "answer": "I can only answer questions about Zepto policies right now.",
            "sources": [],
            "confidence": 1.0,
        }

    prompt = STRUCTURED_PROMPT.format(
        context="No policy retrieval was requested for this general question.",
        question=state["query"],
    )
    raw = call_real_llm(prompt)

    try:
        validated = AskResponse.model_validate_json(raw)
        return {
            "answer": validated.answer,
            "sources": validated.sources,
            "confidence": validated.confidence,
        }
    except ValidationError:
        return {
            "answer": "ERROR: real-LLM output failed schema validation.",
            "sources": [],
            "confidence": 0.0,
        }


def route_by_intent(state: GraphState) -> str:
    return state["intent"]


def call_real_llm(prompt: str) -> str:
    """Optional Groq/OpenAI-compatible extension; never used in mock mode."""
    from openai import OpenAI

    api_key = os.getenv("GROQ_API_KEY")
    if not api_key:
        raise RuntimeError("Set GROQ_API_KEY when MOCK_LLM=0.")

    client = OpenAI(
        api_key=api_key,
        base_url=os.getenv("LLM_BASE_URL", "https://api.groq.com/openai/v1"),
    )
    response = client.chat.completions.create(
        model=os.getenv("LLM_MODEL", "llama-3.1-8b-instant"),
        messages=[{"role": "user", "content": prompt}],
        temperature=0,
    )
    return response.choices[0].message.content


def build_graph():
    builder = StateGraph(GraphState)
    builder.add_node("classify_intent", classify_intent)
    builder.add_node("retrieve_and_answer", retrieve_and_answer)
    builder.add_node("direct_answer", direct_answer)

    builder.add_edge(START, "classify_intent")
    builder.add_conditional_edges(
        "classify_intent",
        route_by_intent,
        {
            "policy_question": "retrieve_and_answer",
            "general_question": "direct_answer",
        },
    )
    builder.add_edge("retrieve_and_answer", END)
    builder.add_edge("direct_answer", END)
    return builder.compile()


graph = build_graph()


def ask(query: str) -> AskResponse:
    state = graph.invoke({"query": query})
    response = AskResponse(
        answer=state["answer"],
        sources=state.get("sources", []),
        confidence=state.get("confidence", 1.0),
    )
    return response

