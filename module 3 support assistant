def build_index():
    """
    Builds a ChromaDB index with some dummy data for demonstration.
    In a real scenario, this would load actual policy documents,
    split them, embed them, and add them to the Chroma collection.
    """
    CHROMA_DIR.mkdir(parents=True, exist_ok=True)

    client = chromadb.PersistentClient(path=str(CHROMA_DIR))
    collection = client.get_or_create_collection(name=COLLECTION_NAME)

    # Dummy documents for demonstration
    documents = [
        "Zepto's delivery policy states that deliveries are typically completed within 30 minutes.",
        "For returns, Zepto offers a 7-day return window for most products, provided they are unused.",
        "Refunds for canceled orders are processed within 3-5 business days.",
        "Membership benefits include free delivery on all orders and exclusive discounts.",
        "Order tracking is available in the Zepto app under 'My Orders'.",
        "To cancel an order, navigate to the 'My Orders' section and select 'Cancel Order' if it's not yet out for delivery.",
        "Zepto gift cards can be purchased and redeemed through the app.",
        "Our customer support hours are 9 AM to 9 PM, Monday to Sunday.",
    ]
    metadatas = [
        {"document_id": "policy_delivery_1"},
        {"document_id": "policy_returns_1"},
        {"document_id": "policy_refunds_1"},
        {"document_id": "policy_membership_1"},
        {"document_id": "policy_tracking_1"},
        {"document_id": "policy_cancel_1"},
        {"document_id": "policy_giftcard_1"},
